{
  "name": "wermaid",
  "version": "0.3.0",
  "description": "Manual layout overrides for vanilla Mermaid: keep the auto layout, nudge what needs it.",
  "type": "module",
  "main": "src/wermaid.js",
  "exports": {
    ".": "./src/wermaid.js"
  },
  "files": [
    "src/wermaid.js",
    "src/themes.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "serve": "node test/serve.mjs . 8765",
    "link-mermaid": "ln -sfn node_modules/mermaid/dist mermaid-dist",
    "test": "node test/run.mjs test/m1.html && node test/interact.mjs && node test/export.mjs"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0"
  },
  "devDependencies": {
    "mermaid": "11.16.1",
    "playwright": "^1.50.0"
  },
  "keywords": ["mermaid", "diagrams", "layout", "editor"]
}
